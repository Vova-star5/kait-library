# Общие правила редакторов для проекта: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# В Markdown два пробела в конце строки означают перенос — их не удаляем
[*.md]
trim_trailing_whitespace = false
