ent="1" source="lvl1-s31" target="lvl1-p12" edge="1"><mxGeometry x="-0.700" y="10" relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="742"/><mxPoint x="1005" y="580"/></Array></mxGeometry></mxCell><mxCell id="lvl1-f69" value="активные брони" style="edgeStyle=none;rounded=0;html=1;jumpStyle=arc;jumpSize=9;strokeColor=#000000;strokeWidth=1.2;endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8462;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#000000;" parent="1" source="lvl1-s31" target="lvl1-p16" edge="1"><mxGeometry x="0.600" y="10" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lvl1-n70" value="Обозначения (нотация Гейна–Сарсона): прямоугольник с тенью — внешняя сущность; скруглённый прямоугольник с номером — процесс; открытый справа прямоугольник — хранилище; стрелка — поток данных, двусторонняя — чтение и запись одних данных. Процессы 2, 4–7 получают id и роль текущего пользователя из процесса 1 (Auth::user). Гость работает как Читатель без входа (процессы 1 и 3). Администратору доступны и функции Библиотекаря." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1"><mxGeometry x="20" y="810" width="1530" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>